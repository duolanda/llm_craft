# LLM Craft — Environment Configuration
# Copy to .env or .env.local to customize

# ── Server ──
# OpenAI-compatible API key for the built-in default
OPENAI_API_KEY=your-key-here

# Default model (optional)
OPENAI_MODEL=gpt-4o-mini

# Custom API endpoint (optional, e.g. for DeepSeek / OpenRouter)
OPENAI_BASE_URL=

# ── Frontend (GitHub Pages / production) ──
# WebSocket URL of your game server.
# For local dev, leave empty (auto-detects localhost:3001).
# For GitHub Pages, set to your game server address, e.g.:
# VITE_WS_URL=ws://your-server-ip:3001
VITE_WS_URL=

# HTTP API base URL (optional, same logic as WS_URL)
VITE_API_BASE_URL=
