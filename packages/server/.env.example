# OpenAI API 配置 (兼容 OpenAI API 格式的其他服务，如 Azure、本地模型等)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 可选: 自定义 API 地址 (留空使用默认 https://api.openai.com/v1)
# OPENAI_BASE_URL=https://your-custom-api.com/v1

# 服务器配置
PORT=3101

# 正式 record/transcript 默认只在启动时生成预览；异常 journal 仍按 orphan 策略自动治理。
LLMCRAFT_RETENTION_APPLY_ON_STARTUP=false
# 每组都支持 MAX_AGE_DAYS / MAX_ENTRIES / MAX_MIB；下列示例覆盖 records 默认值。
# LLMCRAFT_RETENTION_RECORDS_MAX_AGE_DAYS=90
# LLMCRAFT_RETENTION_RECORDS_MAX_ENTRIES=500
# LLMCRAFT_RETENTION_RECORDS_MAX_MIB=10240
# 其他组前缀：BENCHMARK_RECORDS、LLM_DEBUG、BENCHMARK_LLM_DEBUG、ORPHAN_JOURNALS

# 可选：覆盖临时 journal owner 根目录和异常恢复目录。
# LLMCRAFT_JOURNAL_ROOT=/path/to/temporary/journals
# LLMCRAFT_JOURNAL_RECOVERY_DIR=/path/to/durable/orphan-journals
