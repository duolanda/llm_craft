{
  "name": "@llmcraft/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "^22.15.0 || >=23.8.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "analyze:record": "node scripts/analyze-record.mjs",
    "compress:records": "tsx scripts/compress-records.ts",
    "check:strategic": "tsx scripts/strategic-scale-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@llmcraft/shared": "workspace:*",
    "@llmcraft/record": "workspace:*",
    "openai": "^4.24.7",
    "ws": "^8.16.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.9.0",
    "vitest": "^1.1.0"
  }
}
